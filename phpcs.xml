<?xml version="1.0"?>
<ruleset name="Piensa Cookie Consent">
    <description>Coding standards for Piensa Cookie Consent.</description>

    <file>.</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <!-- Bundled third-party library, shipped as upstream releases it. -->
    <exclude-pattern>*/assets/js/cookieconsent.js</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="./"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <config name="minimum_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress-Extra">
        <!-- The codebase uses short array syntax throughout. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- File naming follows the class-*.php convention already in use. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>

        <!--
         Yoda conditions guard against an assignment typo in a comparison.
         PHP 8 makes that a fatal error rather than a silent bug, and the
         inverted reading order costs more than it now buys.
        -->
        <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>

        <!-- The short ternary is used deliberately for option fallbacks. -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
    </rule>

    <!--
     Documentation rules are applied to comment style, not to a requirement
     that every function carry a docblock. Demanding one on each of the
     inherited render_*_field() methods would produce 136 comments restating
     their names, which is noise rather than documentation. New code documents
     what is not obvious from the signature.
    -->
    <rule ref="WordPress-Docs">
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
        <exclude name="Squiz.Commenting.VariableComment.MissingVar"/>
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <exclude name="Squiz.Commenting.FileComment.MissingPackageTag"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
        <!-- The plugin header reads as a file comment to PHPCS. -->
        <exclude name="Squiz.Commenting.ClassComment.WrongStyle"/>
        <exclude name="Squiz.Commenting.FileComment.WrongStyle"/>
    </rule>

    <rule ref="PHPCompatibilityWP"/>

    <!-- Every global symbol must carry the plugin prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="piensa_cookie_consent"/>
                <element value="Piensa_Cookie_Consent"/>
                <element value="PIENSA_COOKIE_CONSENT"/>
            </property>
        </properties>
    </rule>

    <!--
     The test runner is a CLI script that WordPress never loads, so the rules
     guarding the global namespace of a running site do not apply to it. The
     rest of the standard still does.
    -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.PHP.DiscouragedFunctions">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DevelopmentFunctions">
        <exclude-pattern>*/tests/*</exclude-pattern>
    </rule>

    <!-- The text domain must match the wp.org slug. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="piensa-cookie-consent"/>
            </property>
        </properties>
    </rule>
</ruleset>
