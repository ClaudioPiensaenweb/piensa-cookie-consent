<?xml version="1.0"?>
<ruleset name="Piensa Cookie Consent">
    <description>Coding standards for Piensa Cookie Consent.</description>

    <file>.</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="./"/>
    <arg name="parallel" value="8"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="ps"/>

    <config name="minimum_wp_version" value="6.0"/>
    <config name="testVersion" value="7.4-"/>

    <rule ref="WordPress-Extra">
        <!-- The codebase uses short array syntax throughout. -->
        <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
        <!-- File naming follows the class-*.php convention already in use. -->
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    </rule>

    <rule ref="WordPress-Docs">
        <exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
    </rule>

    <rule ref="PHPCompatibilityWP"/>

    <!-- Every global symbol must carry the plugin prefix. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="piensa_cookie_consent"/>
                <element value="Piensa_Cookie_Consent"/>
                <element value="PIENSA_COOKIE_CONSENT"/>
            </property>
        </properties>
    </rule>

    <!-- The text domain must match the wp.org slug. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="piensa-cookie-consent"/>
            </property>
        </properties>
    </rule>
</ruleset>
