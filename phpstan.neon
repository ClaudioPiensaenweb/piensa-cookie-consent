parameters:
    level: 5
    paths:
        - piensa-cookie-consent.php
        - includes
        - uninstall.php
    excludePaths:
        analyseAndScan:
            # Marked optional: the PHP job does not install the npm or composer
            # trees, and PHPStan treats a missing exclude path as a config error.
            - vendor (?)
            - node_modules (?)
    bootstrapFiles:
        - phpstan-bootstrap.php
    # The analysis runs on one PHP version; the plugin supports a range, so
    # guards against older versions are not dead code on the sites that need
    # them.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # WordPress core stubs do not model every dynamic $wpdb property.
        - '#Access to an undefined property wpdb::#'
        # The PHP version guard in the bootstrap is a runtime check.
        -
            message: '#If condition is always false#'
            path: piensa-cookie-consent.php
